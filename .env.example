# Copy to .env for local settings. Never commit .env. Nothing in this file is a secret value.

# Where projects, uploads and the database live. Default: .trustpcb in the repo root.
# TRUSTPCB_DATA_DIR=

# Runner profile for new reviews: muse_api (real reviews with Muse) or scripted (deterministic, calls no model).
# Default: scripted.
# TRUSTPCB_RUNNER=muse_api

# Muse (Meta Messages API), used by the muse_api profile. Set on your machine only.
# The key is the only credential the Muse runner reads or sends. Standard models only: any -contributor model is refused.
# MODEL_API_KEY=
# Reasoning effort: low, medium, high or xhigh. Default medium.
# TRUSTPCB_MUSE_EFFORT=medium
# Where images from tools go: user_message (default) or tool_result.
# TRUSTPCB_MUSE_IMAGE_MODE=
# Set to 0 to use plain responses instead of streaming.
# TRUSTPCB_MUSE_STREAM=1
# Read timeout in seconds (default 180 streaming, 300 plain).
# TRUSTPCB_MUSE_TIMEOUT_S=

# Path to kicad-cli (KiCad 10; the samples and tests use it) if it is not found in the standard install locations or on PATH.
# KICAD_CLI_PATH=

# RF simulation. Build the image with: docker build -f docker/ems/Dockerfile -t trustpcb-ems:dev .
# TRUSTPCB_EMS_IMAGE=trustpcb-ems:dev
# Set to 0 to use the solver code baked into the image instead of the repository's worker/ folder.
# TRUSTPCB_WORKER_MOUNT=1

# Chromium-family browser used only to export report PDFs. Found automatically, and setup installs one.
# TRUSTPCB_BROWSER=

# Largest whole upload, in MiB. Default 512. A zip file is always refused above 100 MB, whatever this is set to,
# and an unpacked project above 500 MB or 5000 files is refused too.
# TRUSTPCB_MAX_UPLOAD_MB=512

# How many PDF exports may run at once (default 1; a few more wait, the rest are refused).
# TRUSTPCB_PDF_CONCURRENCY=1

# Set to baseline to give new reviews no RF lab (as if Docker were missing). Default: the real lab.
# TRUSTPCB_LAB=

# JSON script file for the scripted runner (tests and demos). Default: a short built-in script.
# TRUSTPCB_SCRIPT=

# Add your own runner: a dotted Python module that exposes create_runner(profile). It becomes the default
# runner when TRUSTPCB_RUNNER is not set, and its profile is named after the last part of the module path.
# TRUSTPCB_RUNNER_MODULE=
# A requirements file (relative to the repository root) with extra Python packages that runner needs. Read by npm run dev.
# TRUSTPCB_EXTRA_REQUIREMENTS=

# User id (uid:gid) of the solver container. Default: your own, so the job folder stays readable by you.
# Set it to an empty value to leave the image's user (for example with rootless Docker).
# TRUSTPCB_EMS_USER=
# Comma-separated names of extra environment variables the Docker client may see (it gets a minimal environment otherwise).
# TRUSTPCB_DOCKER_PASS_ENV=

# Advanced. The port the backend accepts in its Host check (default 8118). npm run dev always starts the backend on 8118,
# so change this only if you start the backend yourself, and give the web app its address with TRUSTPCB_BACKEND_URL.
# TRUSTPCB_BACKEND_PORT=8118
# Set by npm run dev for the web app; do not set these in .env: TRUSTPCB_TOKEN, TRUSTPCB_BACKEND_URL.

# Set to 1 to stop npm run dev from opening the browser.
# TRUSTPCB_NO_OPEN=1

# Largest board file read, in MB (default 150), and the longest time spent reading one, in seconds (default 240).
# TRUSTPCB_MAX_PCB_MB=150
# TRUSTPCB_PARSE_TIMEOUT_S=240

# Read-only demo: 1 refuses every change (upload, start, dismiss, chat). Prepare the data with scripts/seed-demo.sh.
# TRUSTPCB_DEMO_READONLY=1
# Repository link shown in the read-only demo notice.
# TRUSTPCB_REPO_URL=
# The GitHub chip on the landing page uses TRUSTPCB_REPO_URL when it is set, and https://github.com/ilovetensor/trustpcb otherwise.
# Discord invite link for the "Join Discord" chip on the landing page. The chip stays hidden while this is unset.
# Read when the web app starts or builds (restart npm run dev after changing it).
# NEXT_PUBLIC_DISCORD_URL=
