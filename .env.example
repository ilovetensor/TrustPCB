# Copy to .env for local overrides. Never commit .env. Nothing here is a secret value.

# Where projects, uploads and the database live. Default: .trustpcb in the repo root.
# TRUSTPCB_DATA_DIR=

# Runner profile for new reviews: local_agent (development, git-ignored), muse_api, or scripted.
# Default: local_agent when it is present and importable, otherwise scripted.
# TRUSTPCB_RUNNER=

# Config folder for the local development runner.
# TRUSTPCB_RUNNER_HOME=

# Key for the muse_api profile (Meta Messages API). Set on your machine only.
# MODEL_API_KEY=

# Largest accepted board upload, in MiB. Default 512.
# TRUSTPCB_MAX_UPLOAD_MB=512

# Set to 1 to stop npm run dev from opening the browser.
# TRUSTPCB_NO_OPEN=1
