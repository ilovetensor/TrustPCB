# Copy to .env for local settings. Never commit .env. Nothing in this file is a secret value.

# Where projects, uploads and the database live. Default: .trustpcb in the repo root.
# TRUSTPCB_DATA_DIR=

# Runner profile for new reviews: muse_api (real reviews with Muse) or scripted (deterministic, calls no model).
# Default: scripted.
# TRUSTPCB_RUNNER=muse_api

# Muse (Meta Messages API), used by the muse_api profile. Set on your machine only.
# The key is the only credential the Muse runner reads or sends. Standard models only: any -contributor model is refused.
# MODEL_API_KEY=
# Reasoning effort: low, medium, high or xhigh. Default medium.
# TRUSTPCB_MUSE_EFFORT=medium
# Where images from tools go: user_message (default) or tool_result.
# TRUSTPCB_MUSE_IMAGE_MODE=
# Set to 0 to use plain responses instead of streaming.
# TRUSTPCB_MUSE_STREAM=1
# Read timeout in seconds (default 180 streaming, 300 plain).
# TRUSTPCB_MUSE_TIMEOUT_S=

# Path to kicad-cli (KiCad 9 or newer) if it is not found in the standard install locations or on PATH.
# KICAD_CLI_PATH=

# RF simulation. Build the image with: docker build -f docker/ems/Dockerfile -t trustpcb-ems:dev .
# TRUSTPCB_EMS_IMAGE=trustpcb-ems:dev
# Set to 0 to use the solver code baked into the image instead of the repository's worker/ folder.
# TRUSTPCB_WORKER_MOUNT=1

# Chrome or Chromium used only to export report PDFs. Found automatically in common locations.
# TRUSTPCB_BROWSER=

# Largest accepted board upload, in MiB. Default 512.
# TRUSTPCB_MAX_UPLOAD_MB=512

# Set to 1 to stop npm run dev from opening the browser.
# TRUSTPCB_NO_OPEN=1

# Largest board file read, in MB (default 150), and the longest time spent reading one, in seconds (default 240).
# TRUSTPCB_MAX_PCB_MB=150
# TRUSTPCB_PARSE_TIMEOUT_S=240

# Read-only demo: 1 refuses every change (upload, start, dismiss, chat). Prepare the data with scripts/seed-demo.sh.
# TRUSTPCB_DEMO_READONLY=1
# Repository link shown in the read-only demo notice.
# TRUSTPCB_REPO_URL=
